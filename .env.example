# ==============================================================================
# Sift - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# When Supabase variables are left empty or unset, Sift gracefully operates in
# Local Storage Mode with starter templates so you can explore immediately.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration (Required for cloud sync & authentication)
# ------------------------------------------------------------------------------
# [Public] Supabase API endpoint (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [Public] Supabase Anonymous Key (Safe for client-side queries protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [Server-Only] Supabase Service Role Key (NEVER expose to client; used for admin/cron)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Application URL (Required for auth redirects and deep link routing)
# ------------------------------------------------------------------------------
# [Public] Root URL of the application
# Local: http://localhost:3000 | Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [Public] The one public address used for canonical links, share images,
# sitemap and robots. Leave empty to use https://sweep-subs.vercel.app
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------------
# 3a. Gmail (free, easiest). Used first when both are set.
# GMAIL_USER is your full gmail address. GMAIL_APP_PASSWORD is a 16 character
# app password from https://myaccount.google.com/apppasswords (needs 2-step verification on).
# ------------------------------------------------------------------------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ------------------------------------------------------------------------------
# 3b. Resend Transactional Email (only if you own a verified domain) (Required for quiet email renewal alerts)
# ------------------------------------------------------------------------------
# [Server-Only] Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# [Server-Only] Sender identity for outgoing reminder emails
RESEND_FROM_EMAIL=Sift Reminders <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 4. Web Push Notification Configuration (VAPID)
# ------------------------------------------------------------------------------
# [Public] VAPID Public Key for browser PushManager subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-vapid-key-here...

# [Server-Only] VAPID Private Key for server-side push payload signing
VAPID_PRIVATE_KEY=your-vapid-private-key-here...

# [Server-Only] VAPID Contact Subject (mailto: URL or contact endpoint)
VAPID_SUBJECT=mailto:support@sift.app

# ------------------------------------------------------------------------------
# 5. Background Cron & Dispatch Security (Optional for automated cron trigger)
# ------------------------------------------------------------------------------
# [Server-Only] Bearer secret to protect the /api/reminders/dispatch webhook
CRON_SECRET=your-random-cron-secret-token-here
